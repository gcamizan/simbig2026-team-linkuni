# Copy to .env (gitignored) and fill in. Never commit .env.
# The model is self-hosted, so no token is required. HF_TOKEN is optional (faster model download).
HF_TOKEN=

# Optional
# TRANSLATE_BACKEND=local              # only 'local' exists
# NLLB_MODEL=facebook/nllb-200-distilled-600M
# PRELOAD_MODEL=1                      # load the model at startup instead of on the first request
# PROXY_SHARED_SECRET=                 # if set, callers must send it in the X-Proxy-Secret header
# ALLOWED_ORIGINS=https://simbig2026-team-linkuni.xcr33d.workers.dev,http://127.0.0.1:8000
